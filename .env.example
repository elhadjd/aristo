# Public site URL (REQUIRED in production for SEO canonicals, sitemap, Open Graph)
# Use your real domain so Google/Bing index the correct URLs.
NEXT_PUBLIC_SITE_URL=https://aristo.zyvoerp.com

# Next.js image optimizer (`/_next/image`). Keep default (omit or true) on custom hosts
# where the optimizer 404s. Set false only on platforms that support it (e.g. Vercel).
# NEXT_IMAGE_UNOPTIMIZED=true

# Public API base (browser + server). Defaults to same-origin /api
NEXT_PUBLIC_API_URL=

# Local SQLite database (Prisma CLI reads `.env`; Next.js also reads `.env.local`)
# Copy this file to BOTH `.env` and `.env.local`
DATABASE_URL="file:./prisma/dev.db"

# Admin bootstrap (used by prisma/seed.ts)
ADMIN_EMAIL=admin@aristo.com
ADMIN_PASSWORD=AristoAdmin123!

# JWT secret for admin sessions
JWT_SECRET=change-me-in-production

# ---------------------------------------------------------------------------
# SISGESC — contact form sync ONLY (catalog is managed in Admin)
# Docs: POST {HOST}/api/site/contacts/submit?key=SUA_CHAVE  → HTTP 201
# ---------------------------------------------------------------------------
# Full endpoint override (optional)
# SISGESC_CONTACT_URL=https://erp.example.com/api/site/contacts/submit

# Host + site API key (REQUIRED for contact forms to reach SISGESC)
# Without these, leads are saved in Admin → Contacts but not sent externally.
SISGESC_API_URL=https://your-sisgesc-host.example.com
SISGESC_SITE_API_KEY=your-site-api-key

# When SISGESC is configured, sync failures always fail the contact form.
# Set true to also fail when SISGESC env vars are missing.
SISGESC_CONTACT_REQUIRED=false
