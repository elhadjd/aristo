# Public site URL (used for SEO canonicals, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://aristo-autos.com

# Public API base (browser + server). Defaults to same-origin /api
NEXT_PUBLIC_API_URL=

# Local SQLite database (Prisma CLI reads `.env`; Next.js also reads `.env.local`)
# Copy this file to BOTH `.env` and `.env.local`
DATABASE_URL="file:./prisma/dev.db"

# Admin bootstrap (used by prisma/seed.ts)
ADMIN_EMAIL=admin@aristo.com
ADMIN_PASSWORD=AristoAdmin123!

# JWT secret for admin sessions
JWT_SECRET=change-me-in-production

# ---------------------------------------------------------------------------
# SISGESC — contact form sync ONLY (catalog is managed in Admin)
# Docs: POST {HOST}/api/site/contacts/submit?key=SUA_CHAVE  → HTTP 201
# ---------------------------------------------------------------------------
# Full endpoint override (optional)
# SISGESC_CONTACT_URL=https://erp.example.com/api/site/contacts/submit

# Host + site API key (recommended)
SISGESC_API_URL=
SISGESC_SITE_API_KEY=

# If true, contact forms fail when SISGESC is unreachable
SISGESC_CONTACT_REQUIRED=false
