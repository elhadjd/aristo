# Public site URL (used for SEO canonicals, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://aristo-autos.com

# Public API base (browser + server). Defaults to same-origin /api
NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# SISGESC Site API (server-side only — never expose the key in the browser)
# Docs: GET {HOST}/api/site/products?key=SUA_CHAVE
# ---------------------------------------------------------------------------

# Host only, e.g. https://erp.yourdomain.com
SISGESC_API_URL=

# Site API key from site_api_keys (query/header `key`)
SISGESC_SITE_API_KEY=

# Optional alias for SISGESC_SITE_API_KEY
# SISGESC_API_KEY=

# Optional company id for GET /api/site/product/{company}/{product}
SISGESC_COMPANY_ID=

# Comma-separated product_type_id values treated as services (default: 2)
SISGESC_SERVICE_TYPE_IDS=2

# Optional media/CDN base when product.image is a relative path
# Defaults to SISGESC_API_URL
SISGESC_MEDIA_URL=

# JWT auth ready (future admin / customer portal)
JWT_SECRET=change-me-in-production
NEXT_PUBLIC_AUTH_ENABLED=false
