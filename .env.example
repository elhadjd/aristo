# Public site URL (used for SEO canonicals, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://aristo-autos.com

# Public API base (browser + server). Defaults to same-origin /api
NEXT_PUBLIC_API_URL=

# Local SQLite database (Prisma)
DATABASE_URL="file:./prisma/dev.db"

# Admin bootstrap (used by prisma/seed.ts)
ADMIN_EMAIL=admin@aristo.com
ADMIN_PASSWORD=AristoAdmin123!

# JWT secret for admin sessions
JWT_SECRET=change-me-in-production

# ---------------------------------------------------------------------------
# SISGESC — contact / lead sync ONLY (catalog is managed in Admin)
# ---------------------------------------------------------------------------
# Full contact endpoint, e.g. https://erp.example.com/api/site/contact
SISGESC_CONTACT_URL=

# Or host + key (defaults to POST {HOST}/api/site/contact?key=...)
SISGESC_API_URL=
SISGESC_SITE_API_KEY=

# If true, contact forms fail when SISGESC is unreachable
SISGESC_CONTACT_REQUIRED=false
